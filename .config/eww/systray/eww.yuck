(defwindow systrayWindow
  :monitor 0
  :exclusive false
  :stack "fg"
  :class "systrayWindow"
  :geometry (geometry 
              :x "100px"
              :y "5px"
              :anchor "top right")
  (box
    (systray-widget)))

(defwidget systray-widget []
  (eventbox
    :onhoverlost "./scripts/systray-toggle.sh"
    ;:orientation "vertical"
    (systray :class "systray")))

